                      "value": "110102",
                    },
                    Object {
                      "label": "朝阳区",
                      "value": "110105",
                    },
                    Object {
                      "label": "海淀区",
                      "value": "110108",
                    },
                  ],
                  "label": "北京市",
                  "value": "110100",
                },
              ],
              "label": "北京市",
              "value": "110000",
            },
            Object {
              "children": Array [
                Object {
                  "children": Array [
                    Object {
                      "label": "和平区",
                      "value": "120101",
                    },
                    Object {
                      "label": "河东区",
                      "value": "120102",
                    },
                    Object {
                      "label": "河西区",
                      "value": "120103",
                    },
                    Object {
                      "label": "南开区",
                      "value": "120104",
                    },
                  ],
                  "label": "天津市",
                  "value": "120100",
                },
              ],
              "label": "天津市",
              "value": "120000",
            },
          ]
        }}"
        title="选择地址"
        value="440300"
        visible="{{false}}"
        bind:change="onChangeCascader"
        bind:visible-change="onCascaderVisibleChange"
      />
    </t-form-item>
    <t-form-item
      label="年限"
      name="age"
    >
      <t-stepper
        disabled="{{false}}"
        theme="filled"
        value="{{3}}"
        bind:change="onChangeStepper"
      />
    </t-form-item>
    <t-form-item
      label="自我评价"
      name="description"
    >
      <t-rate
        allowHalf="{{true}}"
        disabled="{{false}}"
        gap="{{8}}"
        value="{{3.5}}"
        variant="filled"
        bind:change="onRateChange"
      />
    </t-form-item>
    <t-form-item
      label="个人简介"
      name="resume"
      tClassLabel="my-label"
    >
      <t-textarea
        class="textarea"
        disabled="{{false}}"
        indicator="{{true}}"
        maxlength="{{50}}"
        placeholder="请输入个人简介"
        value="本人性格开朗、稳重、细心，待人热情、真诚，工作认真负责，积极主动，勇于创新，具有很强的团队协作精神。"
        bind:change="onTextareaChange"
      />
    </t-form-item>
    <t-form-item
      label="上传照片"
      name="photo"
    >
      <t-upload
        action="https://service-bv448zsw-1257786608.gz.apigw.tencentcs.com/api/upload-demo"
        class="upload"
        disabled="{{false}}"
        files="{{
          Array [
            Object {
              "name": "uploaded1.png",
              "type": "image",
              "url": "https://tdesign.gtimg.com/mobile/demos/example4.png",
            },
            Object {
              "name": "uploaded2.png",
              "type": "image",
              "url": "https://tdesign.gtimg.com/mobile/demos/example6.png",
            },
          ]
        }}"
        gridConfig="{{
          Object {
            "column": 3,
          }
        }}"
        max="{{6}}"
        multiple="{{true}}"
        bind:change="onChangeUpload"
        bind:fail="onFail"
        bind:preview="onPreview"
        bind:progress="onProgress"
        bind:remove="onRemove"
        bind:success="onSuccess"
      />
    </t-form-item>
    <wx-view
      class="button-group"
    >
      <t-button
        formType="reset"
        size="large"
        theme="light"
        bind:tap="reset"
      >
        重置
      </t-button>
      <t-button
        formType="submit"
        size="large"
        theme="primary"
        bind:tap="submit"
      >
        提交
      </t-button>
    </wx-view>
  </t-form>
</base>
`;

