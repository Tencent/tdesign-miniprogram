    >
      <t-input
        borderless="{{true}}"
        disabled="{{false}}"
        placeholder="请选择"
        readonly="{{true}}"
        value=""
        bind:tap="showDatePicker"
      />
      <t-date-time-picker
        format="YYYY-MM-DD"
        mode="date"
        start="2015-01-01"
        title="选择日期"
        visible="{{false}}"
        bind:change="onDatePickerConfirm"
        bind:close="onDatePickerClose"
      />
    </t-form-item>
    <t-form-item
      label="年限"
      name="age"
    >
      <t-stepper
        disabled="{{false}}"
        theme="filled"
        value="{{3}}"
        bind:change="onChangeStepper"
      />
    </t-form-item>
    <wx-view
      class="button-group"
    >
      <t-button
        formType="reset"
        size="large"
        theme="light"
        bind:tap="reset"
      >
        重置
      </t-button>
      <t-button
        formType="submit"
        size="large"
        theme="primary"
        bind:tap="submit"
      >
        提交
      </t-button>
    </wx-view>
  </t-form>
</rules>
`;
