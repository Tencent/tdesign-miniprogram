          },
        ],
        "place": Array [
          Object {
            "message": "不能为空",
            "validator": [Function],
          },
        ],
        "resume": Array [
          Object {
            "message": "不能为空",
            "validator": [Function],
          },
        ],
      }
    }}"
    scrollToFirstError="auto"
    showErrorMessage="{{true}}"
    usingCustomNavbar="{{true}}"
    bind:reset="onReset"
    bind:submit="onSubmit"
  >
    <t-form-item
      label="用户名"
      name="name"
    >
      <t-input
        borderless="{{true}}"
        data-field="name"
        disabled="{{false}}"
        placeholder="请输入用户名"
        value="Abcdefgh"
        bind:change="onInputChange"
      />
    </t-form-item>
    <t-form-item
      label="密码"
      name="password"
    >
      <t-input
        borderless="{{true}}"
        clearable="{{false}}"
        data-field="password"
        disabled="{{false}}"
        placeholder="请输入密码"
        type="password"
        value="Abcdefgh"
        bind:change="onInputChange"
      />
    </t-form-item>
    <t-form-item
      label="性别"
      name="gender"
    >
      <t-radio-group
        borderless="{{true}}"
        class="box"
        disabled="{{false}}"
        value="man"
        bind:change="onRadioChange"
      >
        <t-radio
          block="{{false}}"
          label="男"
          name="radio"
          value="man"
        />
        <t-radio
          block="{{false}}"
          label="女"
          name="radio"
          value="women"
        />
        <t-radio
          block="{{false}}"
          label="保密"
          name="radio"
          value="secret"
        />
      </t-radio-group>
    </t-form-item>
    <t-form-item
      arrow="{{true}}"
      label="生日"
      name="birth"
    >
      <t-input
        borderless="{{true}}"
        disabled="{{false}}"
        placeholder="请选择"
        readonly="{{true}}"
        value="2022-08-10"
        bind:tap="showDatePicker"
      />
      <t-date-time-picker
        format="YYYY-MM-DD"
        mode="date"
        start="2015-01-01"
        title="选择日期"
        visible="{{false}}"
        bind:change="onDatePickerConfirm"
        bind:close="onDatePickerClose"
      />
    </t-form-item>
    <t-form-item
      arrow="{{true}}"
      label="籍贯"
      name="place"
    >
