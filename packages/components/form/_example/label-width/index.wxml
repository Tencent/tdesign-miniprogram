<t-form class="form-demo-form" data="{{formData}}" label-align="left">
  <t-form-item label="用户昵称" name="nickname" label-width="80px">
    <t-input
      value="{{formData.nickname}}"
      borderless
      placeholder="请输入昵称"
      disabled="{{disabled}}"
      data-field="nickname"
      bind:change="onInputChange"
    />
  </t-form-item>
  <t-form-item label="工作年限" name="workAge" label-width="80px">
    <t-stepper
      value="{{formData.workAge}}"
      disabled="{{disabled}}"
      theme="filled"
      data-field="workAge"
      bind:change="onChangeStepper"
    />
  </t-form-item>
</t-form>

