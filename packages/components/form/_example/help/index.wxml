<t-form data="{{formData}}" label-align="{{labelAlign}}">
  <t-form-item label="用户名" name="name" help="用户名支持大小写英文字母，最多 8 个字符">
    <t-input
      value="{{formData.name}}"
      borderless
      placeholder="请输入用户名"
      disabled="{{disabled}}"
      bind:change="onInputChange"
      data-field="name"
    />
  </t-form-item>

  <t-form-item label="密码" name="password" help="密码长度 6–16 位，支持字母、数字">
    <t-input
      value="{{formData.password}}"
      borderless
      type="password"
      clearable="{{false}}"
      placeholder="请输入密码"
      disabled="{{disabled}}"
      bind:change="onInputChange"
      data-field="password"
    />
  </t-form-item>

  <t-form-item label="性别" name="gender" help="性别不能为空">
    <t-radio-group
      value="{{formData.gender}}"
      disabled="{{disabled}}"
      class="box"
      borderless
      bind:change="onRadioChange"
    >
      <t-radio block="{{false}}" name="radio" value="man" label="男" />
      <t-radio block="{{false}}" name="radio" value="women" label="女" />
      <t-radio block="{{false}}" name="radio" value="secret" label="保密" />
    </t-radio-group>
  </t-form-item>

  <t-form-item label="生日" arrow name="birth" help="生日不能为空">
    <t-input
      value="{{formData.birth}}"
      disabled="{{disabled}}"
      borderless
      readonly
      placeholder="请选择"
      bind:tap="showDatePicker"
    />
    <t-date-time-picker
      title="选择日期"
      visible="{{dateVisible}}"
      mode="date"
      format="YYYY-MM-DD"
      start="2015-01-01"
      bind:change="onDatePickerConfirm"
      bind:close="onDatePickerClose"
    />
  </t-form-item>
</t-form>
