var utils = require('../common/utils.wxs');

/** 归一化 action 图标：字符串为图标名，对象为 icon 配置 */
function getIconData(icon) {
  if (utils.isString(icon)) {
    return { name: icon };
  }
  if (utils.isNoEmptyObj(icon)) {
    return icon;
  }
  return null;
}

/** 按 placement 把 actions 分为 start、end 两组，未指定 placement 归入 start */
function getActionGroups(actions) {
  var start = [];
  var end = [];
  if (actions && actions.length) {
    for (var i = 0; i < actions.length; i++) {
      if (actions[i].placement === 'end') {
        end.push(actions[i]);
      } else {
        start.push(actions[i]);
      }
    }
  }
  return [
    { placement: 'start', items: start },
    { placement: 'end', items: end },
  ];
}

/** partial 态「展开更多」文案，兼容 string / [string, string] */
function getPartialExpandContent(content) {
  var partial = content && content.partial;
  if (!partial) return '展开更多回复';
  if (typeof partial === 'string') return partial;
  return partial[0] || '展开更多回复';
}

/** partial 态「收起」文案，content.partial 为字符串时无此文案 */
function getPartialCollapseContent(content) {
  var partial = content && content.partial;
  if (!partial) return '收起';
  if (typeof partial === 'string') return '';
  return partial[1] || '收起';
}

/** 按折叠状态生成折叠项 [{ key, content, expand, icon }] */
function getFoldItems(foldState, commentFolds) {
  var content = (commentFolds && commentFolds.content) || {};
  if (foldState === 'partial') {
    return [
      { key: 'expand', content: getPartialExpandContent(content), expand: true, icon: 'chevron-down' },
      { key: 'collapse', content: getPartialCollapseContent(content), expand: false, icon: 'chevron-up' },
    ];
  }
  if (foldState === 'expanded') {
    return [{ key: 'collapse', content: content.expanded || '收起', expand: false, icon: 'chevron-up' }];
  }
  return [{ key: 'expand', content: content.collapsed || '展开回复', expand: true, icon: 'chevron-down' }];
}

module.exports = {
  getIconData: getIconData,
  getActionGroups: getActionGroups,
  getPartialExpandContent: getPartialExpandContent,
  getPartialCollapseContent: getPartialCollapseContent,
  getFoldItems: getFoldItems,
};
