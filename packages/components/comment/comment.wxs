/** 按 placement 把 actions 分为 start、end 两组，未指定 placement 归入 start */
function getActionGroups(actions) {
  var start = [];
  var end = [];
  if (actions && actions.length) {
    for (var i = 0; i < actions.length; i++) {
      if (actions[i].placement === 'end') {
        end.push(actions[i]);
      } else {
        start.push(actions[i]);
      }
    }
  }
  return [
    { placement: 'start', items: start },
    { placement: 'end', items: end },
  ];
}

/** 生成单个折叠项：expand 键为展开项（chevron-down），其余为收起项（chevron-up） */
function createFoldItem(key, content) {
  var expand = key === 'expand';
  return {
    key: key,
    content: content,
    expand: expand,
    icon: expand ? 'chevron-down' : 'chevron-up',
  };
}

/**
 * 按折叠状态生成折叠项 [{ key, content, expand, icon }]
 * content.partial 支持 string 或 [展开文案, 收起文案]：
 * 为 string 时仅作为展开文案，收起项无文案
 */
function getFoldItems(foldState, commentFolds) {
  var content = (commentFolds && commentFolds.content) || {};
  if (foldState === 'partial') {
    var partial = content.partial;
    var isText = typeof partial === 'string';
    return [
      createFoldItem('expand', isText ? partial : (partial && partial[0]) || '展开更多回复'),
      createFoldItem('collapse', isText ? '' : (partial && partial[1]) || '收起'),
    ];
  }
  if (foldState === 'expanded') {
    return [createFoldItem('collapse', content.expanded || '收起')];
  }
  return [createFoldItem('expand', content.collapsed || '展开回复')];
}

module.exports = {
  getActionGroups: getActionGroups,
  getFoldItems: getFoldItems,
};
