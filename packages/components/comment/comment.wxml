<import src="../common/template/avatar.wxml" />
<import src="../common/template/icon.wxml" />
<wxs src="./comment.wxs" module="_this" />
<wxs src="../common/utils.wxs" module="_" />

<!-- 操作按钮分组模板 -->
<template name="actions-group">
  <view wx:for="{{_this.getActionGroups(actions)}}" wx:key="placement" class="{{classPrefix}}__actions-block">
    <view
      wx:for="{{item.items}}"
      wx:for-item="action"
      wx:key="key"
      class="{{_.cls(classPrefix + '__actions-item', [['disabled', action.disabled]])}}"
      data-action="{{action}}"
      bindtap="handleClickActions"
    >
      <template
        wx:if="{{_this.getIconData(action.icon)}}"
        is="icon"
        data="{{tClass: classPrefix + '__actions-item-icon', ..._this.getIconData(action.icon)}}"
      />
      {{action.content}}
    </view>
  </view>
</template>

<!-- 折叠/展开模板 -->
<template name="folds">
  <view class="{{classPrefix}}__folds" wx:if="{{commentFolds.total > 1}}">
    <view
      wx:for="{{_this.getFoldItems(foldState, commentFolds)}}"
      wx:key="key"
      class="{{classPrefix}}__folds-item"
      data-expand="{{item.expand}}"
      bindtap="handleClickFold"
    >
      <text>{{item.content}}</text>
      <t-icon name="{{item.icon}}" t-class="{{classPrefix}}__folds-item-icon" />
    </view>
  </view>
</template>

<view class="{{classPrefix}} class {{prefix}}-class" style="{{_._style([style, customStyle])}}">
  <view class="{{classPrefix}}__inner">
    <view class="{{classPrefix}}__avatar {{prefix}}-class-avatar">
      <template wx:if="{{avatarData}}" is="avatar" data="{{...avatarData}}" />
      <slot wx:else name="avatar" />
    </view>
    <view class="{{classPrefix}}__detail">
      <view class="{{classPrefix}}__author {{prefix}}-class-author">
        <block wx:if="{{author}}">{{author}}</block>
        <slot wx:else name="author" />
      </view>
      <view class="{{classPrefix}}__content {{prefix}}-class-content">
        <block wx:if="{{content}}">{{content}}</block>
        <slot wx:else name="content" />
      </view>
      <!-- 底部：时间 + 操作 -->
      <view wx:if="{{datetime || actions}}" class="{{classPrefix}}__bottom">
        <view wx:if="{{datetime}}" class="{{classPrefix}}__date {{prefix}}-class-datetime">{{datetime}}</view>
        <view class="{{classPrefix}}__actions {{prefix}}-class-actions">
          <template wx:if="{{actions.length}}" is="actions-group" data="{{classPrefix, actions}}" />
          <slot wx:else name="actions" />
        </view>
      </view>
    </view>
  </view>

  <!-- 回复区 -->
  <view class="{{classPrefix}}__reply">
    <view class="{{classPrefix}}__reply-body" style="{{replyBodyHeight ? 'height:' + replyBodyHeight : ''}}">
      <view class="{{classPrefix}}__reply-inner">
        <slot />
        <slot name="reply" />
      </view>
    </view>
    <template is="folds" data="{{classPrefix, foldState, commentFolds}}" />
  </view>
</view>
