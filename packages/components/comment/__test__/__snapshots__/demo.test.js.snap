exports[`Comment Comment base demo works fine 1`] = `
<base>
  <wx-view
    class="mobile-comment"
  >
    <t-comment
      actions="{{
        Array [
          Object {
            "content": "回复",
            "key": "reply",
            "placement": "start",
          },
          Object {
            "content": "6",
            "disabled": true,
            "icon": "thumb-up",
            "key": "like",
            "placement": "end",
          },
          Object {
            "icon": "uncomfortable-1",
            "key": "dislike",
            "placement": "end",
          },
        ]
      }}"
      avatar="{{
        Object {
          "image": "https://tdesign.gtimg.com/mobile/demos/avatar1.png",
          "shape": "circle",
          "size": "64rpx",
        }
      }}"
      content="这是一段很长很长很长很长很长很长的评论内容。"
      datetime="今天16:38·广东"
      bind:actions="onAction"
    >
      <wx-view
        class="mobile-comment__author"
        slot="author"
      >
        <wx-view>
          Name1 名称
        </wx-view>
        <t-tag
          class="mobile-comment__author-tag"
          shape="round"
          theme="primary"
          variant="light"
        >
          作者
        </t-tag>
      </wx-view>
    </t-comment>
  </wx-view>
</base>
`;

exports[`Comment Comment collapse demo works fine 1`] = `
<collapse>
  <wx-view
    class="mobile-comment"
  >
    <wx-view
      data-author="Name1 名称"
      bind:longpress="onLongPress"
    >
      <t-comment
        avatar="{{
          Object {
            "image": "https://tdesign.gtimg.com/mobile/demos/avatar1.png",
            "shape": "circle",
            "size": "64rpx",
          }
        }}"
        content="这是一段很长很长很长很长很长很长的评论内容。"
        datetime="今天16:38·广东"
        folds="{{
          Object {
            "content": Object {
              "collapsed": "展开5条回复",
              "expanded": "收起",
              "partial": Array [
                "展开更多回复",
                "收起",
              ],
            },
            "state": "collapsed",
            "step": 3,
            "total": 6,
          }
        }}"
        bind:folds="onFolds"
      >
        <wx-view
          class="mobile-comment__author"
          slot="author"
        >
          <wx-view>
            Name1 名称
          </wx-view>
          <t-tag
            class="mobile-comment__author-tag"
            shape="round"
            theme="primary"
            variant="light"
          >
            作者
          </t-tag>
        </wx-view>
        <wx-view
          class="mobile-comment__actions"
          slot="actions"
        >
          <wx-view
            class="mobile-comment__reply-button"
            data-author="Name1 名称"
            bind:tap="onReply"
          >
            回复
          </wx-view>
          <wx-view
            class="mobile-comment__actions-right"
          >
            <t-button
              class="mobile-comment__actions-button"
              icon="thumb-up"
              variant="text"
            >
              6
            </t-button>
            <t-button
              class="mobile-comment__actions-button"
              icon="uncomfortable-1"
              variant="text"
            />
          </wx-view>
        </wx-view>
        <wx-view
          slot="reply"
        >
          <wx-view
            data-author="Name1 名称"
            bind:longpress="onLongPress"
          >
            <t-comment
              avatar="{{
                Object {
                  "image": "https://tdesign.gtimg.com/mobile/demos/avatar1.png",
                  "shape": "circle",
                  "size": "40rpx",
                }
              }}"
              datetime="今天16:38·广东"
            >
              <wx-view
                class="mobile-comment__author"
                slot="author"
              >
                <wx-view>
                  Name1 名称
                </wx-view>
              </wx-view>
              <wx-view
                slot="content"
              >
                这是一段很长很长很长很长很长很长的评论内容。
              </wx-view>
              <wx-view
                class="mobile-comment__actions"
                slot="actions"
              >
                <wx-view
                  class="mobile-comment__reply-button"
                  data-author="Name1 名称"
                  bind:tap="onReply"
                >
                  回复
                </wx-view>
                <wx-view
                  class="mobile-comment__actions-right"
                >
                  <t-button
                    class="mobile-comment__actions-button"
                    data-index="{{0}}"
                    icon="thumb-up"
                    variant="text"
                    bind:tap="onLike"
                  >
                    6
                  </t-button>
                  <t-button
                    class="mobile-comment__actions-button"
                    icon="uncomfortable-1"
                    variant="text"
                  />
                </wx-view>
              </wx-view>
            </t-comment>
          </wx-view>
        </wx-view>
      </t-comment>
    </wx-view>
    <t-action-sheet
      cancelText="取消"
      items="{{
        Array [
          "回复",
          "转发",
          "复制",
          "举报",
        ]
      }}"
      visible="{{false}}"
      bind:cancel="onActionSheetClose"
      bind:close="onActionSheetClose"
      bind:selected="onActionSheetSelect"
    />
  </wx-view>
</collapse>
`;

