<template name="avatar">
  <t-avatar
    t-class="{{tClass || ''}}"
    t-class-image="{{tClassImage || ''}}"
    t-class-icon="{{tClassIcon || ''}}"
    t-class-alt="{{tClassAlt || ''}}"
    t-class-content="{{tClassContent || ''}}"
    alt="{{alt || ''}}"
    badge-props="{{badgeProps || null}}"
    bordered="{{bordered || false}}"
    hide-on-load-failed="{{hideOnLoadFailed || false}}"
    icon="{{icon || ''}}"
    image="{{image || ''}}"
    image-props="{{imageProps || null}}"
    shape="{{shape || ''}}"
    size="{{size || ''}}"
  />
</template>
