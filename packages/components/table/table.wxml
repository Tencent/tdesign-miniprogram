<wxs src="../common/utils.wxs" module="_" />

<!-- 单元格模板 -->
<template name="table-cell">
  <view
    class="{{cell.tdClass}}"
    style="{{cell.cellStyle}}"
    data-row-index="{{rowIndex}}"
    data-col-index="{{cell.colIndex}}"
    bind:tap="onCellClick"
  >
    <!-- 选中列：单选 -->
    <block wx:if="{{cell.columnType === 'single'}}">
      <t-radio
        checked="{{cell.isChecked}}"
        disabled="{{cell.isDisabled}}"
        allow-uncheck="{{cell.allowUncheck}}"
        t-class-icon="{{classPrefix}}__cell-check-icon"
        data-row-index="{{rowIndex}}"
        bind:change="onSelectChange"
      />
    </block>
    <!-- 选中列：多选 -->
    <block wx:elif="{{cell.columnType === 'multiple'}}">
      <t-checkbox
        checked="{{cell.isChecked}}"
        indeterminate="{{cell.isIndeterminate}}"
        disabled="{{cell.isDisabled}}"
        icon="rectangle"
        t-class-icon="{{classPrefix}}__cell-check-icon"
        data-row-index="{{rowIndex}}"
        bind:change="onSelectChange"
      />
    </block>
    <!-- 普通单元格 -->
    <view wx:else class="{{classPrefix}}__td-content">{{cell.content}}</view>
  </view>
</template>

<view class="{{tableClasses}} {{layoutClass}} class {{prefix}}-class" style="{{_._style([style, customStyle])}}">
  <scroll-view
    class="{{contentClasses || classPrefix + '__content'}}"
    style="{{tableContentStyles}}"
    scroll-x
    scroll-y="{{!!(height || maxHeight)}}"
    bindscroll="onScroll"
  >
    <view class="{{classPrefix}}__table-elm" style="{{tableElementStyles}}">
      <!-- 表头 -->
      <view wx:if="{{showHeader}}" class="{{theadClasses}} {{classPrefix}}-class-header">
        <view class="{{classPrefix}}__header-tr">
          <view
            wx:for="{{columns}}"
            wx:for-item="col"
            wx:for-index="colIndex"
            wx:key="colKey"
            class="{{classPrefix}}__th {{thClassNames[colIndex]}}"
            style="{{colStyles[colIndex]}}"
          >
            <!-- 选中列表头：单选显示 title，多选显示全选控件 -->
            <block wx:if="{{col.type === 'single'}}">
              <view class="{{classPrefix}}__th-content">{{col.title}}</view>
            </block>
            <block wx:elif="{{col.type === 'multiple'}}">
              <t-checkbox
                checked="{{allChecked}}"
                indeterminate="{{isIndeterminateChecked}}"
                disabled="{{!hasSelectableRows}}"
                icon="rectangle"
                t-class-icon="{{classPrefix}}__cell-check-icon"
                bind:change="onSelectAll"
              />
            </block>
            <!-- 普通列表头 -->
            <view wx:else class="{{classPrefix}}__th-content"> {{col.title}} </view>
          </view>
        </view>
      </view>

      <!-- 表体 -->
      <view class="{{tbodyClasses}}" style="{{tbodyStyles}}">
        <!-- 空数据 -->
        <view wx:if="{{isEmpty}}" class="{{classPrefix}}__empty-row">
          <view class="{{classPrefix}}__empty" style="grid-column: span {{columnsLength}}">
            <block wx:if="{{empty || globalConfig.empty}}">{{empty || globalConfig.empty}}</block>
            <slot wx:else name="empty" />
          </view>
        </view>

        <!-- 数据行：非合并场景为 flex 行结构，合并场景 body 为 grid 容器、td 跨行跨列 -->
        <block wx:if="{{!hasSpan}}">
          <view
            wx:for="{{renderData}}"
            wx:for-item="rowItem"
            wx:for-index="trIndex"
            wx:key="rowId"
            class="{{classPrefix}}__tr {{classPrefix}}__tr-{{trIndex}} {{rowItem.rowClass}}"
            style="{{rowItem.rowStyle}}"
            data-row-index="{{rowItem.rowIndex}}"
            bind:tap="onRowClick"
          >
            <block wx:for="{{rowItem.cells}}" wx:for-item="cell" wx:key="colKey">
              <template is="table-cell" data="{{ cell, rowIndex: rowItem.rowIndex, classPrefix }}" />
            </block>
          </view>
        </block>

        <block wx:else>
          <block wx:for="{{renderData}}" wx:for-item="rowItem" wx:key="rowId">
            <block wx:for="{{rowItem.cells}}" wx:for-item="cell" wx:key="colKey">
              <template
                wx:if="{{!cell.skipped}}"
                is="table-cell"
                data="{{ cell, rowIndex: rowItem.rowIndex, classPrefix }}"
              />
            </block>
          </block>
        </block>
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="{{classPrefix}}__loading--full">
      <slot name="loading">
        <t-loading />
      </slot>
    </view>
  </scroll-view>

  <!-- 表尾总结行 -->
  <view wx:if="{{footerSummary}}" class="{{classPrefix}}__bottom-content {{classPrefix}}-class-footer">
    {{footerSummary}}
  </view>
  <slot name="footer-summary" />
</view>
