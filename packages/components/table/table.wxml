<wxs src="../common/utils.wxs" module="_" />

<!-- 单元格模板 -->
<template name="table-cell">
  <view
    class="{{cell.tdClass}} {{draggingColIndex === cell.colIndex ? classPrefix + '__td--dragging' : ''}}"
    style="{{cell.cellStyle}}"
    data-row-index="{{rowIndex}}"
    data-col-index="{{cell.colIndex}}"
    bind:tap="onCellClick"
  >
    <view class="{{classPrefix}}__td-content">{{cell.content}}</view>
  </view>
</template>

<view class="{{tableClasses}} {{layoutClass}} class {{prefix}}-class" style="{{_._style([style, customStyle])}}">
  <scroll-view
    class="{{contentClasses || classPrefix + '__content'}}"
    style="{{tableContentStyles}}"
    scroll-x
    scroll-y="{{!!(height || maxHeight)}}"
    bindscroll="onScroll"
  >
    <view class="{{classPrefix}}__table-elm" style="{{tableElementStyles}}">
      <!-- 表头 -->
      <view wx:if="{{showHeader}}" class="{{theadClasses}} {{classPrefix}}-class-header">
        <view class="{{classPrefix}}__header-tr">
          <view
            wx:for="{{columns}}"
            wx:for-item="col"
            wx:for-index="colIndex"
            wx:key="colKey"
            class="{{classPrefix}}__th {{thClassNames[colIndex]}} {{dragColEnabled ? classPrefix + '__th--drag-sort' : ''}} {{draggingColIndex === colIndex ? classPrefix + '__th--dragging' : ''}} {{col.sorter ? classPrefix + '__th--sortable' : ''}}"
            style="{{colStyles[colIndex]}} {{draggingColIndex === colIndex ? colDragTransform : ''}}"
            data-col-index="{{colIndex}}"
            bind:touchstart="onColTouchStart"
            bind:touchmove="onColTouchMove"
            bind:touchend="onColTouchEnd"
          >
            <view class="{{classPrefix}}__th-content">
              <text>{{col.title}}</text>
              <view wx:if="{{col.sorter}}" class="{{classPrefix}}__sort-trigger">
                <view class="{{classPrefix}}__sort-icons">
                  <t-icon
                    wx:if="{{!col.sortType || col.sortType === 'all' || col.sortType === 'asc'}}"
                    name="chevron-down"
                    t-class="{{classPrefix}}__sort-icon {{classPrefix}}__sort-icon--asc {{sortMap[col.colKey] && !sortMap[col.colKey].descending ? classPrefix + '__sort-icon--active' : classPrefix + '__sort-icon--default'}}"
                    size="32rpx"
                    data-col-index="{{colIndex}}"
                    data-descending="{{false}}"
                    catch:tap="onSortIconClick"
                  />
                  <t-icon
                    wx:if="{{!col.sortType || col.sortType === 'all' || col.sortType === 'desc'}}"
                    name="chevron-down"
                    t-class="{{classPrefix}}__sort-icon {{sortMap[col.colKey] && sortMap[col.colKey].descending ? classPrefix + '__sort-icon--active' : classPrefix + '__sort-icon--default'}}"
                    size="32rpx"
                    data-col-index="{{colIndex}}"
                    data-descending="{{true}}"
                    catch:tap="onSortIconClick"
                  />
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 表体 -->
      <view class="{{tbodyClasses}}" style="{{tbodyStyles}}">
        <!-- 空数据 -->
        <view wx:if="{{isEmpty}}" class="{{classPrefix}}__empty-row">
          <view class="{{classPrefix}}__empty" style="grid-column: span {{columnsLength}}">
            <block wx:if="{{empty || globalConfig.empty}}">{{empty || globalConfig.empty}}</block>
            <slot wx:else name="empty" />
          </view>
        </view>

        <!-- 数据行：非合并场景为 flex 行结构，合并场景 body 为 grid 容器、td 跨行跨列 -->
        <block wx:if="{{!hasSpan}}">
          <view
            wx:for="{{renderData}}"
            wx:for-item="rowItem"
            wx:for-index="trIndex"
            wx:key="rowId"
            class="{{classPrefix}}__tr {{classPrefix}}__tr-{{trIndex}} {{rowItem.rowClass}} {{rowItem.draggingClass}}"
            style="{{rowItem.rowStyle}} {{rowItem.dragTransform}}"
            data-row-index="{{rowItem.rowIndex}}"
            bind:tap="onRowClick"
            bind:touchstart="onRowTouchStart"
            bind:touchmove="onRowTouchMove"
            bind:touchend="onRowTouchEnd"
          >
            <block wx:for="{{rowItem.cells}}" wx:for-item="cell" wx:key="colKey">
              <template is="table-cell" data="{{ cell, rowIndex: rowItem.rowIndex, classPrefix, draggingColIndex }}" />
            </block>
          </view>
        </block>

        <block wx:else>
          <block wx:for="{{renderData}}" wx:for-item="rowItem" wx:key="rowId">
            <block wx:for="{{rowItem.cells}}" wx:for-item="cell" wx:key="colKey">
              <template
                wx:if="{{!cell.skipped}}"
                is="table-cell"
                data="{{ cell, rowIndex: rowItem.rowIndex, classPrefix, draggingColIndex }}"
              />
            </block>
          </block>
        </block>
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="{{classPrefix}}__loading--full">
      <slot name="loading">
        <t-loading />
      </slot>
    </view>
  </scroll-view>

  <!-- 表尾总结行 -->
  <view wx:if="{{footerSummary}}" class="{{classPrefix}}__bottom-content {{classPrefix}}-class-footer">
    {{footerSummary}}
  </view>
  <slot name="footer-summary" />
</view>
